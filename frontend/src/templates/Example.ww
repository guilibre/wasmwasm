param atk = 0.01
param dur = 1
param rel = 0.5
param legato = 0
param freq = 440

static env = 0
static t_sin = 0

OUT[0] <- 0.2*env*sin(t_sin)

static gate = 1
gate ? (
  env < 1 ? env = atk <= 0 ? 1 : env + 1/(atk*SAMPLE_RATE)
) : (
  env = env - 1/(rel*SAMPLE_RATE)
)
env = min 1 (max 0 env)
env <= 0 ? die

static dt_env = 1/SAMPLE_RATE
static t_env = 0
legato == 0 ? t_env = t_env + dt_env
t_env >= dur ? gate = 0

static two_pi = 2*PI
static dt_base = two_pi/SAMPLE_RATE
dt_sin = freq*dt_base
t_sin = t_sin + dt_sin
t_sin >= two_pi ? t_sin = t_sin - two_pi
