{
    "name": "wasmwasm",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "deploy": "gh-pages -d dist",
        "lint": "eslint .",
        "predeploy": "npm run build",
        "preview": "vite preview",
        "update-coi": "curl -o public/coi-serviceworker.js https://raw.githubusercontent.com/gzuidhof/coi-serviceworker/master/coi-serviceworker.js"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
