# Copiar para .env e preencher. Usado por docker-compose (variáveis ${...})
# e, em dev local sem Docker, deve ser exportado no ambiente antes de rodar backwasm
# (ex: `set -a; source .env; set +a; ./build/backwasm`).

# --- App / DB (produção, docker-compose.yml) ---
DB_TNS_ALIAS=localhost:1521/FREEPDB1
DB_USER=backwasm
DB_PASSWORD=devpassword123

# --- Oracle DB local (dev, docker-compose.dev.yml) ---
ORACLE_PWD=devpassword123

# --- Caddy (produção) ---
DOMAIN=

# --- App (todas as execuções) ---
JWT_SECRET=dev-only-secret-nao-usar-em-producao
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=true
